# Copy to local-server/.env (or run: npm run keygen)

PORT=8787
HTTPS_PORT=8788

# Comma-separated API keys accepted by /api/*. Leave empty to disable auth
# (only safe on a machine that nothing else can reach).
REELIO_API_KEYS=replace-with-a-long-random-string

# HMAC secret for short-lived download tokens (browser downloads can't send headers).
REELIO_TOKEN_SECRET=replace-with-another-long-random-string
REELIO_TOKEN_TTL=300

# Which frontend origins may call this server. "*" allows all.
ALLOWED_ORIGINS=*

# Queue / concurrency limits
MAX_CONCURRENT_DOWNLOADS=2
MAX_CONCURRENT_INFO=4
MAX_QUEUE_LENGTH=20
JOB_TIMEOUT_MS=900000

# Optional explicit binary paths
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# Optional TLS files for the HTTPS proxy (defaults to local-server/certs/)
# TLS_KEY_PATH=
# TLS_CERT_PATH=
