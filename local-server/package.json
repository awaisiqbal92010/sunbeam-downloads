{
  "name": "reelio-local-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local Node.js backend for Reelio: yt-dlp + ffmpeg extraction, API-key auth, job queue and an optional HTTPS reverse proxy.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "proxy": "node https-proxy.js",
    "certs": "node scripts/make-cert.js",
    "keygen": "node scripts/make-key.js",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "http-proxy": "^1.18.1",
    "selfsigned": "^2.4.1",
    "youtube-dl-exec": "^3.0.10"
  }
}
